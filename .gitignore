# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Streamlit
.streamlit/

# v2 session data (keep JSON metadata, ignore large/binary artifacts)
data/survey_projects/**/*.csv
data/survey_projects/**/*.parquet
data/survey_projects/**/thumbnails/*.jpg
data/survey_projects/**/*.log.jsonl
data/survey_projects/**/*.png
!data/survey_projects/**/floorplan.png

# Legacy HeatMap session trees (optional local data)
data/survey_projects/**/presence_sessions/**
data/survey_projects/**/survey_sessions/**

# RuView reference clone build artifacts
RuView/v2/target/
RuView/**/build/

# Trained models (large binary weights)
data/models/**/weights.pt
data/models/**/confusion.png

# Live-mode runtime state
data/runtime/
data/runtime/esp32_state.json

# Generated outputs
output/heatmaps/*.png
output/reports/*.pdf
output/exports/

# Floorplan raw files (large images — not tracked)
floorplans/raw/*
!floorplans/raw/.gitkeep
floorplans/processed/*
!floorplans/processed/.gitkeep

# 3D scan files
scans/raw/*
!scans/raw/.gitkeep
scans/processed/*
!scans/processed/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# GitNexus
.gitnexus
